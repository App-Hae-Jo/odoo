<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_iload_order" model="ir.sequence">
            <field name="name">Iload Order Sequence</field>
            <field name="code">iload.order.sequence</field>
            <field name="prefix"></field> <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_iload_vehicle_acquisition" model="ir.sequence">
            <field name="name">Iload Vehicle Acquisition Sequence</field>
            <field name="code">iload.vehicle.acquisition.sequence</field>
            <field name="prefix">ACQ%(y)s%(month)s%(day)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>