<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for iload.shipping.document -->
        <record id="view_iload_shipping_document_list" model="ir.ui.view">
            <field name="name">iload.shipping.document.list</field>
            <field name="model">iload.shipping.document</field>
            <field name="arch" type="xml">
                <list string="선적 문서 목록">
                    <field name="name"/>
                    <field name="shipping_id"/>
                    <field name="document_type"/>
                    <field name="issue_date"/>
                </list>
            </field>
        </record>

        <!-- Form View for iload.shipping.document -->
        <record id="view_iload_shipping_document_form" model="ir.ui.view">
            <field name="name">iload.shipping.document.form</field>
            <field name="model">iload.shipping.document</field>
            <field name="arch" type="xml">
                <form string="선적 문서 정보">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="shipping_id"/>
                            <field name="document_type"/>
                            <field name="issue_date"/>
                            <field name="attachment" widget="binary" filename="name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for iload.shipping.document -->
        <record id="action_iload_shipping_document_menu" model="ir.actions.act_window">
            <field name="name">선적 문서 관리</field>
            <field name="res_model">iload.shipping.document</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>