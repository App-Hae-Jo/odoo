<odoo>
    <data>
        <record id="view_iload_vehicle_acquisition_document_tree" model="ir.ui.view">
            <field name="name">iload.vehicle.acquisition.document.tree</field>
            <field name="model">iload.vehicle.acquisition.document</field>
            <field name="arch" type="xml">
                <list string="매입 문서 목록">
                    <field name="name"/>
                    <field name="document_type"/>
                    <field name="acquisition_id"/>
                    <field name="acquisition_chassis_number"/>
                    <field name="order_detail_id"/>
                    <field name="attachment_id" widget="url" text="Download"/>
                    <field name="issue_date"/>
                </list>
            </field>
        </record>

        <record id="view_iload_vehicle_acquisition_document_form" model="ir.ui.view">
            <field name="name">iload.vehicle.acquisition.document.form</field>
            <field name="model">iload.vehicle.acquisition.document</field>
            <field name="arch" type="xml">
                <form string="매입 문서">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="document_type"/>
                                <field name="acquisition_id"/>
                                <field name="order_detail_id"/>
                            </group>
                            <group>
                                <field name="attachment_id"/>
                                <field name="issue_date"/>
                                <field name="acquisition_chassis_number" readonly="1"/>
                                <field name="acquisition_seller_name" readonly="1"/>
                            </group>
                        </group>
                        <field name="description"/>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>