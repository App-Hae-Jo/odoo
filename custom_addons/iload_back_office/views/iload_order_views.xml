<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_iload_order_view" model="ir.actions.act_window">
            <field name="name">운송 주문</field>
            <field name="res_model">iload.order</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    새로운 주문을 생성하세요!
                </p>
            </field>
        </record>

        <record id="view_iload_order_list" model="ir.ui.view">
            <field name="name">iload.order.list</field>
            <field name="model">iload.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="order_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_iload_order_form" model="ir.ui.view">
            <field name="name">iload.order.form</field>
            <field name="model">iload.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="destination_address"/>
                                <field name="destination_country_id"/>
                            </group>
                            <group>
                                <field name="order_date"/>
                                <!-- <field name="delivery_date"/> -->
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="total_amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="주문 상세">
                                <field name="order_detail_ids">
                                    <list editable="bottom"> <field name="sequence" widget="handle"/>
                                        <field name="vehicle_id"/>
                                        <field name="chassis_number"/>
                                        <field name="fuel_type"/>
                                        <field name="amount"/>
                                        <field name="requested_delivery_date"/>
                                        <field name="state"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <!-- <page string="추가 정보">
                                <field name="description"/>
                            </page> -->
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>