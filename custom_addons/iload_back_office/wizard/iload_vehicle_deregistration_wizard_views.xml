<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_iload_vehicle_deregistration_wizard_form" model="ir.ui.view">
            <field name="name">iload.vehicle.deregistration.wizard.form</field>
            <field name="model">iload.vehicle.deregistration.wizard</field>
            <field name="arch" type="xml">
                <form string="차량 말소 등록">
                    <group>
                        <field name="deregistration_certificate" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="확인" type="object" class="btn-primary"/>
                        <button string="취소" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_iload_vehicle_deregistration_wizard" model="ir.actions.act_window">
            <field name="name">차량 말소 등록</field>
            <field name="res_model">iload.vehicle.deregistration.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
