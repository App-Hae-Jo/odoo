<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="iload_shipping_mark_template_a">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align: center;">Shipping Mark (Template A)</h2>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">Discharging Port:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.discharging_port"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">Shipper:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.shipper_name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">Tel:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.shipper_tel"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">Car Name:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.car_name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">VIN No:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.vin_no"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">Final Destination:</td>
                                <td style="border: 1px solid black; padding: 8px;"><span t-field="wizard.final_destination"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <template id="iload_shipping_mark_template_b">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align: center; color: blue;">Shipping Mark (Template B)</h2>
                        <div style="border: 2px solid blue; padding: 15px; margin-top: 20px;">
                            <p><strong>Discharging Port:</strong> <span t-field="wizard.discharging_port"/></p>
                            <p><strong>Shipper:</strong> <span t-field="wizard.shipper_name"/> (Tel: <span t-field="wizard.shipper_tel"/>)</p>
                            <p><strong>Vehicle:</strong> <span t-field="wizard.car_name"/> (VIN: <span t-field="wizard.vin_no"/>)</p>
                            <p><strong>Destination:</strong> <span t-field="wizard.final_destination"/></p>
                        </div>
                        <p style="margin-top: 30px; font-style: italic;">Generated by iLoad System</p>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>