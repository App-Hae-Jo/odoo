<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for iload.vehicle -->
        <record id="iload_vehicle_view_tree" model="ir.ui.view">
            <field name="name">iload.vehicle.list</field>
            <field name="model">iload.vehicle</field>
            <field name="arch" type="xml">
                <list string="Iload 차량 정보">
                    <field name="name"/>
                    <field name="vehicle_type"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <!-- Form View for iload.vehicle -->
        <record id="iload_vehicle_view_form" model="ir.ui.view">
            <field name="name">iload.vehicle.form</field>
            <field name="model">iload.vehicle</field>
            <field name="arch" type="xml">
                <form string="Iload 차량 정보">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_type"/>
                            <field name="is_active"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for iload.vehicle -->
        <record id="iload_vehicle_action" model="ir.actions.act_window">
            <field name="name">Iload 차량 정보</field>
            <field name="res_model">iload.vehicle</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    새로운 차량 모델을 생성하세요!
                </p>
            </field>
        </record>

        <!-- Menu Item for iload.vehicle -->
        <!-- Assuming a top-level menu for 'Iload' exists or will be created.
             If not, you might need to create a parent menu first.
             For now, I'll place it under a generic 'Configuration' or 'Settings' if available,
             or create a new top-level 'Iload' menu if no suitable parent is found.
             Let's check the manifest for existing menu structures.
        -->
      

    </data>
</odoo>