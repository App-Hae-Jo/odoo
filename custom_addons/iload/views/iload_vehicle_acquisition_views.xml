<odoo>
    <data>
        <!-- action 정의 -->
        <record id="action_iload_vehicle_acquisition_view" model="ir.actions.act_window">
            <field name="name">
                매입 관리
            </field>
            <field name="res_model">iload.vehicle.acquisition</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    매입한 차량을 관리해보세요!
                </p>
            </field>
            <field name="binding_model_id" ref="model_iload_vehicle_acquisition"/>
        </record>

        <record id="view_iload_vehicle_acquisition_list" model="ir.ui.view">
            <field name="name">iload.vehicle.acquisition.list</field>
            <field name="model">iload.vehicle.acquisition</field>
            <field name="arch" type="xml">
                <list string="차량 매입 목록">
                    <header>
                        <button name="%(iload_back_office.action_iload_ocr_upload_vehicle_wizard)d"
                                type="action"
                                string="OCR 문서 업로드"
                                class="oe_highlight" display="always"/>
                        <button name="action_open_deregistration_wizard"
                                type="object"
                                string="말소 등록"
                                class="oe_highlight"/>
                    </header>
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="fuel_type"/>
                    <field name="acquisition_date"/>
                    <field name="seller_name"/>
                    <field name="mileage"/>
                    <field name="acquisition_from_type"/>
                    <field name="car_registration_number"/>
                    <field name="chassis_number"/>
                    <field name="storage_location"/>
                    <field name="acquisition_amount" sum="Total Acquisition"/>
                    <field name="deregistration_status"/>
                    <field name="deregistration_date"/>
                    <field name="storage_location"/>
                </list>
            </field>
        </record>

        <record id="view_iload_vehicle_acquisition_form" model="ir.ui.view">
            <field name="name">iload.vehicle.acquisition.form</field>
            <field name="model">iload.vehicle.acquisition</field>
            <field name="arch" type="xml">
                <form string="차량 매입 정보">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="판매자 정보">
                                <field name="acquisition_date"/>
                                <field name="acquisition_from_type"/>
                                <field name="seller_name"/>
                                <field name="seller_registration_no"/>
                                <field name="acquisition_amount" widget="monetary" options="{'currency_field': 'acquisition_currency_id'}"/>
                                <field name="acquisition_currency_id" invisible="1"/>
                            </group>
                            <group string="판매자 주소 및 연락처">
                                <field name="seller_address"/>
                                <field name="seller_contact_person"/>
                                <field name="seller_phone"/>
                            </group>
                            <group string="차량 정보">
                                <group>
                                    <field name="vehicle_id"/>
                                    <field name="english_vehicle_name"/>
                                    <field name="fuel_type"/>
                                    <field name="car_registration_number"/>
                                    <field name="chassis_number"/>
                                    <field name="deregistration_status"/>
                                    <field name="deregistration_date" invisible="[('deregistration_status', '=', False)]"/>
                                    <field name="storage_location"/>
                                </group>
                                <group>
                                    <field name="mileage"/>
                                    <field name="vehicle_weight"/>
                                    <field name="engine_displacement"/>
                                </group>
                            </group>
                            <group string="주문 정보">
                                <field name="order_detail_id" string="차량"/>
                                <field name="no_order_detail_message" invisible="order_detail_id != False" nolabel="1"/>
                                <group invisible="order_detail_id == False">
                                    <field name="order_detail_amount" string="주문 금액" readonly="1"/>
                                    <field name="order_detail_currency_id" string="통화" readonly="1"/>
                                    <field name="order_detail_requested_delivery_date" string="주문 상세 납기 요청일" readonly="1"/>
                                    <field name="order_detail_description" string="메모" readonly="1"/>
                                </group>
                            </group>
                        </group>
                        <notebook>
                            <page string="매입 관련 문서">
                                <field name="acquisition_document_ids">
                                    <list>
                                        <field name="name" />
                                        <field name="attachment" filename="name"/>
                                        <field name="document_type"/>
                                        <field name="issue_date"/>
                                        <field name="description"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="acquisition_id" invisible="1"/>
                                                <field name="name" invisible="1"/>
                                                <field name="attachment" filename="name"/>
                                                <field name="document_type"/>
                                                <field name="issue_date"/>
                                                <field name="description"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>
    </data>
</odoo>